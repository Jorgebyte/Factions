{
    "name": "jorgebyte/factions",
    "description": "Factions plugin for PocketMine-MP 5.0+",
    "type": "project",
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "Jorgebyte",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "pocketmine/pocketmine-mp": "^5.36.0",
        "cortexpe/commando": "^3.0",
        "poggit/libasynql": "^4.0",
        "dapigguy/libpiggyeconomy": "^2.1",
        "sofe/await-generator": "^3.0",
        "ivancraft623/languages": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Jorgebyte\\Factions\\": "src/Jorgebyte/Factions/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jorgebyte\\Factions\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "phpstan": "phpstan analyze",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
